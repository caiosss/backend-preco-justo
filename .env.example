# Porta da API
PORT=3333
NODE_ENV=development

# Postgres (docker compose sobe em localhost:5433)
DATABASE_URL=postgres://preco_justo:preco_justo@localhost:5433/preco_justo

# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=30d

# Origens liberadas no CORS, separadas por vírgula. Aceita curinga (https://*.vercel.app); "*" libera todas
CORS_ORIGIN=http://localhost:5173,http://localhost:4173,https://*.vercel.app

# Assistente de IA (repo agente-preco-justo). Sem AGENT_URL, /api/agent/chat responde 503.
# Agente local: AGENT_URL=http://localhost:8000 (com a API no Docker: http://host.docker.internal:8000).
# AGENT_KEY é o mesmo valor nos dois serviços: python -c "import secrets; print(secrets.token_hex(32))"
AGENT_URL=
AGENT_KEY=
# Perguntas por dia somando todas as pessoas (teto de gasto com o modelo)
AGENT_DAILY_LIMIT=100

# Endereço do app (PWA), usado no link do e-mail de redefinir senha
APP_URL=http://localhost:5173

# E-mail pela API do Resend (resend.com; o Railway bloqueia SMTP). Sem a chave, em desenvolvimento
# o link de redefinir senha aparece no log da API. EMAIL_FROM precisa ser de um domínio verificado no Resend.
RESEND_API_KEY=
EMAIL_FROM=Preço Justo <onboarding@resend.dev>

# Somente homologação (perfil "homolog" do docker compose)
NGROK_AUTHTOKEN=
# Opcional: domínio estático gratuito do ngrok (ex.: meu-app.ngrok-free.app)
NGROK_DOMAIN=
