# Porta da API
PORT=3333
NODE_ENV=development

# Postgres (docker compose sobe em localhost:5433)
DATABASE_URL=postgres://preco_justo:preco_justo@localhost:5433/preco_justo

# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=30d

# Origens liberadas no CORS, separadas por vírgula. Aceita curinga (https://*.vercel.app); "*" libera todas
CORS_ORIGIN=http://localhost:5173,http://localhost:4173,https://*.vercel.app

# Somente homologação (perfil "homolog" do docker compose)
NGROK_AUTHTOKEN=
# Opcional: domínio estático gratuito do ngrok (ex.: meu-app.ngrok-free.app)
NGROK_DOMAIN=
